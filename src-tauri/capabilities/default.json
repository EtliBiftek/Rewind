{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs (events, webview drag & drop), open/save dialogs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
